<procedure>
  <preliminaryRqmts>
    <reqCondGroup>
      <reqCondNoRef><reqCond>Aircraft on jacks</reqCond></reqCondNoRef>
    </reqCondGroup>
    <reqSupportEquips>
      <supportEquipDescrGroup>
        <supportEquipDescr>
          <name>Torque wrench</name>
          <identNumber><manufacturerCode>00000</manufacturerCode><partAndSerialNumber><partNumber>TW-100</partNumber></partAndSerialNumber></identNumber>
          <reqQuantity>1</reqQuantity>
        </supportEquipDescr>
      </supportEquipDescrGroup>
    </reqSupportEquips>
    <reqSupplies>
      <supplyDescrGroup>
        <supplyDescr>
          <name>Grease</name>
          <identNumber><manufacturerCode>00000</manufacturerCode><partAndSerialNumber><partNumber>GR-1</partNumber></partAndSerialNumber></identNumber>
          <reqQuantity>1</reqQuantity>
        </supplyDescr>
      </supplyDescrGroup>
    </reqSupplies>
    <reqSpares>
      <spareDescrGroup>
        <spareDescr>
          <name>Seal</name>
          <identNumber><manufacturerCode>00000</manufacturerCode><partAndSerialNumber><partNumber>SL-9</partNumber></partAndSerialNumber></identNumber>
          <reqQuantity>2</reqQuantity>
        </spareDescr>
      </spareDescrGroup>
    </reqSpares>
    <reqSafety>
      <safetyRqmts>
        <warning><warningAndCautionPara>Isolate electrical power.</warningAndCautionPara></warning>
      </safetyRqmts>
    </reqSafety>
  </preliminaryRqmts>
  <mainProcedure>
    <proceduralStep id="stp-0001">
      <para>Open the access panel.</para>
      <proceduralStep>
        <para>Remove the four screws.</para>
        <note><notePara>Keep the screws.</notePara></note>
      </proceduralStep>
      <proceduralStep>
        <para>Lift the panel.</para>
      </proceduralStep>
    </proceduralStep>
    <proceduralStep>
      <warning><warningAndCautionPara>Hot surface.</warningAndCautionPara></warning>
      <para>Remove the unit.</para>
      <proceduralStep><para>Support the unit while the last screw is removed.</para></proceduralStep>
    </proceduralStep>
  </mainProcedure>
  <closeRqmts>
    <reqCondGroup>
      <reqCondNoRef><reqCond>Panel closed</reqCond></reqCondNoRef>
    </reqCondGroup>
  </closeRqmts>
</procedure>
