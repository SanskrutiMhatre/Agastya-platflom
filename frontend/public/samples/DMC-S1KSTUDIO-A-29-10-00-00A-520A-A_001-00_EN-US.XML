  <content>
    <procedure>
      <preliminaryRqmts>
        <reqCondGroup>
          <reqCondNoRef>
            <reqCond>Aircraft on wheels with hydraulic power off</reqCond>
          </reqCondNoRef>
        </reqCondGroup>
        <reqSupportEquips>
          <supportEquipDescrGroup>
            <supportEquipDescr id="seq-0001">
              <name>Torque wrench, 10-100 Nm</name>
              <identNumber>
                <manufacturerCode>S1K01</manufacturerCode>
                <partAndSerialNumber>
                  <partNumber>TW-100</partNumber>
                </partAndSerialNumber>
              </identNumber>
              <reqQuantity>1</reqQuantity>
            </supportEquipDescr>
            <supportEquipDescr id="seq-0002">
              <name>Container, 5 l</name>
              <identNumber>
                <manufacturerCode>S1K01</manufacturerCode>
                <partAndSerialNumber>
                  <partNumber>CNT-5L</partNumber>
                </partAndSerialNumber>
              </identNumber>
              <reqQuantity>1</reqQuantity>
            </supportEquipDescr>
          </supportEquipDescrGroup>
        </reqSupportEquips>
        <reqSupplies>
          <noSupplies/>
        </reqSupplies>
        <reqSpares>
          <noSpares/>
        </reqSpares>
        <reqSafety>
          <safetyRqmts>
            <warning>
              <warningAndCautionPara>Make sure that the hydraulic system is depressurized before you disconnect the lines. Fluid under pressure can cause injury.</warningAndCautionPara>
            </warning>
          </safetyRqmts>
        </reqSafety>
      </preliminaryRqmts>
      <mainProcedure>
        <proceduralStep id="stp-0001">
          <para>Release the hydraulic pressure of the green system.</para>
        </proceduralStep>
        <proceduralStep id="stp-0002">
          <para>Put the container (<internalRef internalRefId="seq-0002" internalRefTargetType="irtt05"/>) below the pump.</para>
        </proceduralStep>
        <proceduralStep id="stp-0003">
          <caution>
            <warningAndCautionPara>Install blanking caps on all open ports immediately to prevent contamination.</warningAndCautionPara>
          </caution>
          <para>Disconnect the hydraulic lines:</para>
          <proceduralStep id="stp-0004">
            <para>Disconnect the pressure line.</para>
          </proceduralStep>
          <proceduralStep id="stp-0005">
            <para>Disconnect the case drain line.</para>
          </proceduralStep>
          <proceduralStep id="stp-0006">
            <para>Disconnect the suction line.</para>
          </proceduralStep>
        </proceduralStep>
        <proceduralStep id="stp-0007">
          <para>Remove the six nuts and washers with the torque wrench (<internalRef internalRefId="seq-0001" internalRefTargetType="irtt05"/>).</para>
        </proceduralStep>
        <proceduralStep id="stp-0008">
          <para>Remove the pump from the gearbox pad.</para>
          <note>
            <notePara>Keep the pump in the horizontal position to prevent fluid spillage.</notePara>
          </note>
        </proceduralStep>
      </mainProcedure>
      <closeRqmts>
        <reqCondGroup>
          <noConds/>
        </reqCondGroup>
      </closeRqmts>
    </procedure>
  </content>
