; Agastya Platform - configuration
;
; Lines starting with ; are comments. Every setting is optional; the value shown is the default.
; Changes take effect the next time the application or the Windows service starts.
; More about each setting: OPERATIONS.md (installed beside this program, in the "docs" folder).

[server]
; The address in the browser is http://localhost:<Port>/
Port=@PORT@
; loopback = reachable from this computer only (recommended).
; lan      = reachable from other computers too. The Windows firewall still has to allow it (see OPERATIONS.md).
; Or give one specific IPv4 address of this computer.
; Anything other than loopback is a server on the network (Mode B) and needs a certificate under [tls]: the server does not start without one.
Bind=@BIND@
; Other names people use to reach this server, comma-separated (the names in the certificate are always accepted).
;ServerNames=docs.example.local

[tls]
; The server's certificate (Mode B). Either a PEM certificate and its key, or one .pfx file. A relative path is relative to this file's folder.
; The passphrase of an encrypted key or a .pfx is read from a file; keep these files readable by the service and administrators only.
; Prefer a certificate from your organisation's CA. Without one, "node app\backend\scripts\make-tls-cert.js" makes one (OPERATIONS.md).
;Certificate=tls\server.pem
;Key=tls\server-key.pem
;Pfx=tls\server.pfx
;PassphraseFile=tls\passphrase.txt
; Strict-Transport-Security max-age in seconds on HTTPS answers (0 = none). Default 15552000 (180 days).
;HstsMaxAge=15552000

[storage]
; Where projects, house templates and the database are kept. Back this folder up.
; Empty = "workspace" next to this file's data folder.
DataDir=@DATADIR@

[security]
; Set to 1 when people reach the server through HTTPS (for example behind a reverse proxy).
SecureCookies=0

[app]
; 1 = open the browser when the tray application starts.
OpenBrowser=1
; Where it opens: auto = an app window of Microsoft Edge when Edge is installed, otherwise the default browser (with a notice);
; app = the same as auto; browser = always the default browser.
;Window=auto

[update]
; Offline updates (AgastyaCtl.exe --apply-update <file.agupdate>, OPERATIONS.md "Updates").
; Earlier versions kept for a rollback (AgastyaCtl.exe --rollback), 1-10.
;KeepVersions=2
; Seconds a new version has to answer /api/version and /api/ready before it is rolled back automatically, 15-900.
;HealthSeconds=60
; Further certificates (SHA-1 thumbprints, comma-separated) that may sign an update package, for a certificate renewal.
; The certificate that signed the installed program is always accepted.
;TrustedThumbprints=

[logging]
; Each log file is closed and renamed (.1, .2, ...) when it reaches this size; the oldest beyond KeepFiles are deleted.
MaxFileMB=10
KeepFiles=5

[service]
; The name of the Windows service when the service is installed.
Name=@SERVICENAME@
