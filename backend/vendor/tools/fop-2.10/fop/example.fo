<?xml version="1.0"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" font-size="10pt" font-family="Helvetica"
  text-align="left" line-height="normal" font-selection-strategy="character-by-character"
  line-height-shift-adjustment="disregard-shifts" writing-mode="lr-tb" language="en">
  <fo:layout-master-set>
    <fo:simple-page-master master-name="blank" page-width="210mm" page-height="11in"
      margin-top="11mm" margin-bottom="12mm" margin-left="15mm" margin-right="10mm">
      <fo:region-body display-align="center" margin-bottom="25mm" margin-top="25mm"
        margin-left="0in" margin-right="15mm" region-name="blank-body" />
      <fo:region-before region-name="xsl-region-before-blank" extent="15mm" precedence="true"
        display-align="before" />
      <fo:region-after region-name="xsl-region-after-blank" extent="17.5mm" precedence="true"
        display-align="after" />
      <fo:region-start border-width="0" padding="0" reference-orientation="90"
        region-name="xsl-region-outer-blank" precedence="false" extent="0in" />
      <fo:region-end border-width="0" padding="0" reference-orientation="90"
        region-name="xsl-region-inner-blank" precedence="false" extent="0in" />
    </fo:simple-page-master>
    <fo:simple-page-master master-name="titlepage-first" page-width="210mm" page-height="11in"
      margin-top="11mm" margin-bottom="12mm" margin-left="10mm" margin-right="15mm">
      <fo:region-body margin-bottom="25mm" margin-top="25mm" column-gap="12pt" column-count="1"
        margin-left="15mm" margin-right="0in" />
      <fo:region-before region-name="xsl-region-before-first" extent="15mm" precedence="true"
        display-align="before" />
      <fo:region-after region-name="xsl-region-after-first" extent="17.5mm" precedence="true"
        display-align="after" />
      <fo:region-start border-width="0" padding="0" reference-orientation="90"
        region-name="xsl-region-inner-first" precedence="false" extent="0in" />
      <fo:region-end border-width="0" padding="0" reference-orientation="90"
        region-name="xsl-region-outer-first" precedence="false" extent="0in" />
    </fo:simple-page-master>
    <fo:simple-page-master master-name="titlepage-odd" page-width="210mm" page-height="11in"
