    <fo:simple-page-master xmlns:d="http://docbook.org/ns/docbook"
      xmlns:l="http://docbook.sourceforge.net/xmlns/l10n/1.0"
      xmlns:rx="http://www.renderx.com/XSL/Extensions" master-name="body-first-dbtofo"
